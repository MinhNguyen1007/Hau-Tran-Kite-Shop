# Copy sang .env.local rồi điền. KHÔNG commit .env.local.

# --- Supabase local: lấy từ output của `supabase start` ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: CHỈ dùng server-side, không bao giờ prefix NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth: khai trong supabase/config.toml, provider google ---
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
